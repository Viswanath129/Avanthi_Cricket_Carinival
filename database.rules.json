{
  "rules": {
    "presence": {
      ".read": true,
      "$userKey": {
        ".read": true,
        ".write": "auth != null || $userKey.beginsWith('pub_') || true",
        "$connId": {
          ".read": true,
          ".write": "auth != null || $userKey.beginsWith('pub_') || true"
        }
      }
    },
    "publicStats": {
      ".read": true,
      ".write": true,
      "liveUsers": {
        ".read": true,
        ".write": true
      }
    },
    "auctionState": {
      ".read": true,
      ".write": true
    },
    "players": {
      ".read": true,
      ".write": true
    }
  }
}
