{
  "rules": {
    "presence": {
      ".read": true,
      "$userKey": {
        ".read": true,
        ".write": "auth != null || $userKey.beginsWith('pub_')",
        "$connId": {
          ".read": true,
          ".write": "auth != null || $userKey.beginsWith('pub_')"
        }
      }
    },
    "presence_test": {
      ".read": true,
      ".write": true
    },
    "publicStats": {
      "liveUsers": {
        ".read": true,
        ".write": true
      }
    },
    "auctionState": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
