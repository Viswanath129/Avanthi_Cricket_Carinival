@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

:root {
  --bg-950: #050807;
  --bg-900: #09110d;
  --bg-800: #0e1813;
  --surface: #111c16;
  --surface-2: #17241d;
  --surface-3: #1d2d24;
  --green-500: #19c37d;
  --green-400: #32e58f;
  --orange-500: #ff8a1f;
  --orange-400: #ffb45c;
  --red-500: #ff4d4f;
  --yellow-400: #ffd166;
  --text-100: #f5f7f6;
  --text-200: #dce5df;
  --text-400: #93a59a;
  --text-500: #6e8175;
  --border: rgba(255,255,255,.09);
  --shadow: 0 20px 60px rgba(0,0,0,.35);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin:0;
  background: radial-gradient(circle at 80% 10%, rgba(25,195,125,.12), transparent 35%), var(--bg-950);
  color: var(--text-100);
  font-family: Inter, sans-serif;
}
.font-display { font-family: "Space Grotesk", sans-serif; }
.font-mono { font-family: "JetBrains Mono", monospace; }
.glass {
  background: linear-gradient(135deg, rgba(255,255,255,.07), rgba(255,255,255,.025));
  border: 1px solid var(--border);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 50px rgba(0,0,0,.25);
}
.price {
  font-family: "JetBrains Mono", monospace;
  font-size: clamp(3.5rem, 9vw, 7.5rem);
  font-weight: 700;
  letter-spacing: -0.08em;
  line-height: .9;
  color: var(--orange-400);
  text-shadow: 0 0 40px rgba(255,138,31,.25);
}
.price-sm {
  font-family: "JetBrains Mono", monospace;
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.06em;
}
.eyebrow {
  font-size: .68rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-500);
  font-weight: 700;
}
.live-dot {
  width:8px; height:8px; border-radius:50%; background: var(--green-500);
  box-shadow: 0 0 0 0 rgba(25,195,125,.7);
  animation: livePulse 2s infinite;
}
@keyframes livePulse {
  0% { box-shadow: 0 0 0 0 rgba(25,195,125,.7); }
  70% { box-shadow: 0 0 0 10px rgba(25,195,125,0); }
  100% { box-shadow: 0 0 0 0 rgba(25,195,125,0); }
}
.auction-timer {
  display:grid; place-items:center;
  width: 180px; height: 180px;
  margin: 1.5rem auto;
  border-radius: 50%;
  border: 8px solid rgba(25,195,125,.18);
  background: radial-gradient(circle, rgba(25,195,125,.12), transparent 70%);
  transition: all .25s ease;
}
.auction-timer.warning { border-color: var(--yellow-400); }
.auction-timer.danger { border-color: var(--red-500); animation: pulse .7s infinite; }
@keyframes pulse { 50% { transform: scale(1.04); } }
.bid-update { animation: bidPulse .35s ease-out; }
@keyframes bidPulse {
  0% { transform: scale(.92); opacity:.4; }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); opacity:1; }
}
.team-strip {
  display:grid;
  grid-template-columns: repeat(11, minmax(60px, 1fr));
  gap: 10px;
}
@media (max-width: 900px) {
  .team-strip { grid-template-columns: repeat(6, 1fr); }
}
@media (max-width: 500px) {
  .team-strip { grid-template-columns: repeat(3, 1fr); }
}
.team {
  padding: 10px 6px;
  border-radius: 12px;
  text-align:center;
  border: 1px solid var(--border);
  transition: transform .18s cubic-bezier(.2,.8,.2,1), opacity .18s;
}
.team.active {
  border-color: var(--green-500);
  background: rgba(25,195,125,.12);
}
.team.passed { opacity:.35; }
.team.blocked {
  border-color: var(--red-500);
  background: rgba(255,77,79,.08);
}
.team.warning {
  border-color: var(--yellow-400);
  background: rgba(255,209,102,.08);
}
.bid-button {
  background: linear-gradient(135deg, #19c37d, #0d9d63);
  color: white;
  border: none;
  min-height: 96px;
  border-radius: 20px;
  cursor: pointer;
  font-family: "Space Grotesk", sans-serif;
  font-weight: 700;
  display:flex; align-items:center; justify-content:space-between;
  padding: 0 28px;
  width:100%;
  transition: all .18s;
  box-shadow: 0 10px 30px rgba(25,195,125,.25);
}
.bid-button:disabled {
  background: #252d29;
  color: #68746d;
  cursor:not-allowed;
  box-shadow:none;
}
.player-grid {
  container-type: inline-size;
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:1rem;
}
@container (max-width: 900px) {
  .player-grid { grid-template-columns: repeat(2, 1fr); }
}
@container (max-width: 500px) {
  .player-grid { grid-template-columns: 1fr; }
}
.scrollbar-none::-webkit-scrollbar { display:none; }
.scrollbar-none { -ms-overflow-style:none; scrollbar-width:none; }
