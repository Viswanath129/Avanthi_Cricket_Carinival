rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserDoc().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'SUPER_ADMIN' || getUserRole() == 'ADMIN');
    }

    function isFranchise() {
      return isAuthenticated() && (
        getUserRole() == 'FRANCHISE_COORDINATOR' ||
        getUserRole() == 'FRANCHISE_TEAM_LEADER' ||
        getUserRole() == 'FRANCHISE'
      );
    }

    function isFranchiseOwner(franchiseId) {
      return isAuthenticated() && (
        getUserDoc().franchiseId == franchiseId ||
        get(/databases/$(database)/documents/franchiseUsers/$(request.auth.uid)).data.franchiseId == franchiseId
      );
    }

    // ── Users (/users/{uid}) ──────────────────────────────────────────
    // Canonical user directory.
    // Self or admin can read. Super Admin governs all writes.
    // Safe self-registration creates initial PENDING profile only (Points 4, 10, 34, 58).
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == uid &&
        (
          (request.resource.data.role == 'PLAYER' &&
           request.resource.data.accountStatus == 'PENDING' &&
           request.resource.data.approvalStatus == 'PENDING_APPROVAL') ||
          (request.resource.data.role == 'FRANCHISE_COORDINATOR' &&
           request.resource.data.accountStatus == 'PENDING' &&
           request.resource.data.approvalStatus == 'PENDING_APPROVAL')
        );
      allow update: if isSuperAdmin();
      // Player identity is referenced by historical auction records. Purging is
      // only available through the server-side reference-checking governance function.
      allow delete: if false;
    }

    // ── Editions (public read, Super Admin write) ─────────────────────
    match /editions/{editionId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /auction/state {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /buckets/{bucketId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ── Players (private, authoritative directory) ────────────────────
    // Only admin or the player themselves can read.
    // Self-registration creates with PENDING status.
    // Players cannot self-approve or alter auction eligibility (Point 34, 58).
    match /players/{playerId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        resource.data.rollNumber == request.auth.uid ||
        resource.data.rollNumberNormalized == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.accountStatus == 'PENDING' &&
        request.resource.data.approvalStatus == 'PENDING_APPROVAL' &&
        request.resource.data.auctionEligible == false;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.uid == request.auth.uid || resource.data.authUid == request.auth.uid) &&
          request.resource.data.accountStatus == resource.data.accountStatus &&
          request.resource.data.approvalStatus == resource.data.approvalStatus &&
          request.resource.data.auctionEligible == resource.data.auctionEligible
        )
      );
      // Player purges must use the server callable that checks protected history.
      allow delete: if false;
    }

    // ── Player Unique Keys (uniqueness enforcement) ───────────────────
    match /playerUniqueKeys/{keyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ── Players Public Projection ─────────────────────────────────────
    // Public read for live spectator experience (500+ viewers without login).
    // Write restricted to admin and Cloud Functions.
    match /playersPublic/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Franchises (private, admin and authorized franchise owner read) ─
    match /franchises/{franchiseId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isFranchiseOwner(franchiseId) || 
        resource.data.primaryAuthUid == request.auth.uid || 
        resource.data.secondaryAuthUid == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.status == 'PENDING' &&
        request.resource.data.primaryAuthUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Franchises Public Projection ──────────────────────────────────
    match /franchisesPublic/{franchiseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Franchise Users (admin and self read, Super Admin write) ──────
    match /franchiseUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isSuperAdmin();
    }

    // ── Lots (public read, admin write) ───────────────────────────────
    match /lots/{lotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Bids (public read, franchise or admin create, no update/delete) ─
    match /bids/{bidId} {
      allow read: if true;
      allow create: if isAdmin() || isFranchise();
      allow update, delete: if false;
    }

    // ── Auction State (public read, admin or franchise write) ─────────
    match /acc_auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || isFranchise();
    }

    // ── Sales / Acquisitions (public read, Super Admin write) ─────────
    match /acquisitions/{acqId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Audit Logs (admin read, admin create, NO update/delete) ───────
    // Immutable audit trail.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // Legacy audit records remain readable in the unified timeline. New writes
    // go through the server-side writer into auditLogs.
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Settings (admin read/write) ───────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
