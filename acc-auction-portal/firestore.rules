rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'SUPER_ADMIN' || getUserRole() == 'ADMIN');
    }
    
    function isFranchise() {
      return isAuthenticated() && (
        getUserRole() == 'FRANCHISE_COORDINATOR' || 
        getUserRole() == 'FRANCHISE_TEAM_LEADER' || 
        getUserRole() == 'FRANCHISE'
      );
    }
    
    function isPlayer() {
      return isAuthenticated() && getUserRole() == 'PLAYER';
    }
    
    // Users - canonical user directory (/users/{uid})
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Only Super Admin can grant or modify roles, status, or administrative access
      allow write: if isSuperAdmin();
    }
    
    // Editions - public read, Super Admin write
    match /editions/{editionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
      
      match /auction/state {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /buckets/{bucketId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }
    
    // Players (authoritative private directory)
    // - Unverified players cannot be read by public
    // - Players can only read/edit their own record
    // - Approval, verificationStatus, and auctionEligible cannot be mutated by player
    match /players/{playerId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid ||
        resource.data.roll == request.auth.uid ||
        resource.data.rollNumberNormalized == request.auth.uid
      );
      // New candidate self-registration: must start with PENDING_APPROVAL and auctionEligible: false
      allow create: if true;
      // Normal candidate updates: cannot self-approve or elevate privilege
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.uid == request.auth.uid && 
         request.resource.data.approvalStatus == 'PENDING_APPROVAL' &&
         request.resource.data.auctionEligible == false)
      );
      // Historical safety: player deletion restricted to Super Admin
      allow delete: if isSuperAdmin();
    }

    // Unique Registration Keys (Uniqueness enforcement for roll and mobile)
    match /playerUniqueKeys/{keyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }
    
    // Players Public Projection - public read, admin/system write only
    // Strips private contacts (mobile, email, password) from public view
    match /playersPublic/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Franchises - public read, Super Admin governance write
    match /franchises/{franchiseId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Franchise Users - admin and self read, Super Admin write
    match /franchiseUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
    }
    
    // Lots - public read, admin write
    match /lots/{lotId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bids - public read, verified franchise or admin write
    match /bids/{bidId} {
      allow read: if true;
      allow write: if isAdmin() || isFranchise();
    }
    
    // Authoritative Live Auction State
    match /acc_auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || isFranchise();
    }

    // Acquisitions - public read, Super Admin write
    match /acquisitions/{acqId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Audit Logs - admin only read and write
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
