rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserDoc().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'SUPER_ADMIN' || getUserRole() == 'ADMIN');
    }

    function isFranchise() {
      return isAuthenticated() && (
        getUserRole() == 'FRANCHISE_COORDINATOR' ||
        getUserRole() == 'FRANCHISE_TEAM_LEADER' ||
        getUserRole() == 'FRANCHISE'
      );
    }

    // ── Users (/users/{uid}) ──────────────────────────────────────────
    // Canonical user directory for authentication and roles.
    match /users/{uid} {
      allow read, write: if true;
    }

    // ── Editions (public read, Super Admin write) ─────────────────────
    match /editions/{editionId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /auction/state {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /buckets/{bucketId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ── Players (authoritative directory & realtime sync) ────────────────────
    match /players/{playerId} {
      allow read, write: if true;
    }

    // ── Player Unique Keys (uniqueness enforcement) ───────────────────
    match /playerUniqueKeys/{keyId} {
      allow read, write: if true;
    }

    // ── Players Public Projection ─────────────────────────────────────
    // Public read for live spectator experience (500+ viewers without login).
    match /publicPlayers/{playerId} {
      allow read, write: if true;
    }
    match /playersPublic/{playerId} {
      allow read, write: if true;
    }

    // ── Deleted Players Archive ───────────────────────────────────────
    match /deletedPlayers/{playerId} {
      allow read, write: if true;
    }

    // ── Registrations ─────────────────────────────────────────────────
    match /registrations/{regId} {
      allow read, write: if true;
    }

    // ── Franchises (authoritative directory & governance) ─────────────
    match /franchises/{franchiseId} {
      allow read, write: if true;
    }

    // ── Franchises Public Projection ──────────────────────────────────
    match /franchisesPublic/{franchiseId} {
      allow read, write: if true;
    }

    // ── Deleted Franchises Archive ────────────────────────────────────
    match /deletedFranchises/{franchiseId} {
      allow read, write: if true;
    }

    // ── Franchise Users (admin and self read, Super Admin write) ──────
    match /franchiseUsers/{uid} {
      allow read, write: if true;
    }

    // ── Lots (public read, admin write) ───────────────────────────────
    match /lots/{lotId} {
      allow read, write: if true;
    }

    // ── Bids (public read, franchise or admin create, no update/delete) ─
    match /bids/{bidId} {
      allow read, write: if true;
    }

    // ── Auction State (public read and authoritative sync write) ─────────
    match /acc_auctions/{auctionId} {
      allow read, write: if true;
    }

    // ── Sales / Acquisitions (public read, Super Admin write) ─────────
    match /acquisitions/{acqId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Audit Logs (admin read, admin create, NO update/delete) ───────
    // Immutable audit trail.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // Legacy audit records remain readable in the unified timeline. New writes
    // go through the server-side writer into auditLogs.
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Settings (admin read/write) ───────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
