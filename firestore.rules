rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'SUPER_ADMIN' || getUserRole() == 'ADMIN');
    }

    function isFranchise() {
      return isAuthenticated() && (
        getUserRole() == 'FRANCHISE_COORDINATOR' ||
        getUserRole() == 'FRANCHISE_TEAM_LEADER' ||
        getUserRole() == 'FRANCHISE'
      );
    }

    function isFranchiseOwner(franchiseId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/franchiseUsers/$(request.auth.uid)).data.franchiseId == franchiseId
      );
    }

    // ── Users (/users/{uid}) ──────────────────────────────────────────
    // Canonical user directory. Only self or admin can read. Super Admin governs writes.
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
    }

    // ── Editions (public read, Super Admin write) ─────────────────────
    match /editions/{editionId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /auction/state {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /buckets/{bucketId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // ── Players (private, authoritative directory) ────────────────────
    // Only admin or the player themselves can read.
    // Self-registration creates with PENDING status.
    // Players cannot self-approve or elevate privilege.
    match /players/{playerId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.roll == request.auth.uid ||
        resource.data.rollNumberNormalized == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.uid == request.auth.uid &&
         request.resource.data.approvalStatus == 'PENDING_APPROVAL' &&
         request.resource.data.auctionEligible == false)
      );
      allow delete: if isSuperAdmin();
    }

    // ── Player Unique Keys (uniqueness enforcement) ───────────────────
    // Only authenticated users can create. Admin governs updates/deletes.
    match /playerUniqueKeys/{keyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ── Players Public Projection ─────────────────────────────────────
    // Public read. Write ONLY by Cloud Functions (admin SDK bypasses rules).
    // No client write allowed — not even admin — to preserve data pipeline integrity.
    match /playersPublic/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Franchises (private, admin and self read) ─────────────────────
    match /franchises/{franchiseId} {
      allow read: if isAuthenticated() && (isAdmin() || isFranchiseOwner(franchiseId));
      allow write: if isSuperAdmin();
    }

    // ── Franchises Public Projection ──────────────────────────────────
    // Public read. Write ONLY by Cloud Functions.
    match /franchisesPublic/{franchiseId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Franchise Users (admin and self read, Super Admin write) ──────
    match /franchiseUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isSuperAdmin();
    }

    // ── Lots (public read, admin write) ───────────────────────────────
    match /lots/{lotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Bids (public read, franchise or admin create, no update/delete) ─
    match /bids/{bidId} {
      allow read: if true;
      allow create: if isAdmin() || isFranchise();
      allow update, delete: if false;
    }

    // ── Auction State (public read, admin or franchise write) ─────────
    match /acc_auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || isFranchise();
    }

    // ── Sales / Acquisitions (public read, Super Admin write) ─────────
    match /acquisitions/{acqId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Audit Logs (admin read, admin create, NO update/delete) ───────
    // Immutable audit trail. Once written, entries cannot be modified.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Settings (admin read/write) ───────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
